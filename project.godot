[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/epic-online-services-godot/plugin.cfg", "res://addons/flatten_for_llm/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[physics]

