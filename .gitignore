# Godot 4+ specific ignores
.godot/
/android/

# EOS secrets config
eos_config.cfg

# Debug probe files
_probe*.gd
_probe*.gd.uid

# Temporary files & backups
~*
*.tmp
*.bak
Thumbs.db

# OpenCode local workspace
.omo/

# Addons: keep only epic-online-services-godot, ignore everything else
# (local tool/plugin configs such as godot_ai / flatten_for_llm)
addons/*
!addons/epic-online-services-godot/
!addons/epic-online-services-godot/**

# ...but keep ignoring editor temp/backup files inside the kept addon
addons/epic-online-services-godot/**/~*
